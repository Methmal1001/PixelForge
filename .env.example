# PiXdEm AI STUDIO (DEMANS) — settings reference
# The app stores each user's settings privately in:
#   %APPDATA%\DEMANS\PiXdEm AI STUDIO\settings.env
# Users normally set these in the app: Settings → AI provider.
# No API keys are included with the software; every user adds their own.
#
# Active provider: pollinations (free, no key), manus or gemini
AI_PROVIDER=pollinations
# Manus API key (Manus web app → Settings → API Integration)
MANUS_API_KEY=
MANUS_AGENT_PROFILE=lite
# Google AI Studio key (aistudio.google.com/apikey; image generation needs billing)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
